{
  "name": "what-do-i-watch",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://jakelawrence.github.io/what-do-i-watch",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "admin:create": "node scripts/admin/create-admin-user.mjs",
    "audit:tmdb-ids": "node scripts/maintenance/audit-tmdb-ids.mjs",
    "db:semantic-inventory": "node scripts/maintenance/semantic-search-inventory.mjs",
    "sync:providers": "node scripts/maintenance/sync-watch-providers.mjs",
    "sync:posters": "node scripts/maintenance/sync-tmdb-posters.mjs",
    "sync:languages": "node scripts/maintenance/sync-tmdb-languages.mjs",
    "inventory:phase1": "node scripts/migration/phase-1-inventory.mjs --out docs/migration/phase-1-inventory.json --include-tmdb",
    "inventory:phase1:strict": "node scripts/migration/phase-1-inventory.mjs --out docs/migration/phase-1-inventory.json --include-tmdb --strict",
    "migrate:phase3:export": "node scripts/migration/phase-3-export-dynamodb.mjs",
    "migrate:phase3:transform": "node scripts/migration/phase-3-transform.mjs",
    "migrate:phase3:load": "node scripts/migration/phase-3-load-postgres.mjs",
    "migrate:phase3:validate": "node scripts/migration/phase-3-validate.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.806.0",
    "@aws-sdk/lib-dynamodb": "^3.806.0",
    "@heroicons/react": "^2.2.0",
    "aws-sdk": "^2.1692.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "flickity": "^3.0.0",
    "jose": "^6.1.3",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.474.0",
    "next": "^15.2.4",
    "next-auth": "^5.0.0-beta.31",
    "node-cache": "^5.1.2",
    "postgres": "^3.4.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-remove-scroll": "^2.7.2",
    "react-responsive-carousel": "^3.2.23",
    "swr": "^2.3.3"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1"
